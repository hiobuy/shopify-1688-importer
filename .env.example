# Copy to .env. Never commit .env or your SQLite database.
# Leave these three blank. `npm run dev` creates the Shopify app and fills them in.
# A placeholder here makes `shopify app dev` look up an app that does not exist.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_files,write_files
# prisma resolves relative file paths from prisma/schema.prisma.
DATABASE_URL=file:./dev.sqlite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep stable and back it up securely. Encrypts HIOBuy keys and Shopify session tokens.
ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
# Optional first-run server-side HIOBuy key; the Settings page can override/remove it.
HIOBUY_API_KEY=
PORT=3000
