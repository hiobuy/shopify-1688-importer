{
  "name": "hiobuy-1688-to-shopify",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Shopify Embedded App using only the HIOBuy Public API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:app": "node --env-file-if-exists=.env node_modules/@react-router/dev/bin.js dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration.test.ts",
    "check:security": "node scripts/security-check.mjs",
    "check:licenses": "node scripts/license-check.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:security && npm run check:licenses",
    "shopify": "shopify",
    "db:studio": "prisma studio",
    "test:visual": "node scripts/visual-check.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write app tests scripts docs README.md THIRD_PARTY_NOTICES.md *.json *.ts *.yaml .github/workflows/ci.yml"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "decimal.js": "^10.6.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@react-router/dev": "7.18.2",
    "@shopify/cli": "^4.9.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "esbuild": "$esbuild"
  }
}
